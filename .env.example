# Google Gemini API Key (AI 리포트 고품질 분석 — 권장)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API Key (선택 — Gemini 미설정 시 대체)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Custom Search API (선택 — 더 정확한 검색 결과)
# https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# 이메일 발송 (네이버 SMTP)
# 네이버 메일 > 환경설정 > POP3/IMAP > SMTP 사용 + 2단계 인증 후 앱 비밀번호 발급
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kimddll@naver.com
SMTP_PASS=네이버_앱_비밀번호
SMTP_FROM=kimddll@naver.com
REPORT_RECIPIENT_EMAIL=kimddll@naver.com

# Resend API (선택 — SMTP 대신 사용 가능)
# https://resend.com 에서 무료 API 키 발급
RESEND_API_KEY=
RESEND_FROM=AI 뉴스 리포트 <onboarding@resend.dev>
